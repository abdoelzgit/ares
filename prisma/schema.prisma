datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  DIREKTUR
  WAKASEK
  GURU
  PEMBINA
  TU
  KEUANGAN
}

enum ConfidentialityLevel {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
}

model Category {
  id         String               @id @default(uuid()) @db.Uuid
  code       String               @unique
  name       String
  createdAt  DateTime             @default(now()) @map("created_at")
  documents  Document[]
  roleAccess RoleCategoryAccess[]
  userAccess UserCategoryAccess[]   // ← tambahkan baris ini

  @@map("categories")
}

// Menentukan role mana saja yang boleh mengakses kategori mana saja.
// Tidak ada row untuk kombinasi role+category = LOCKED (default deny).
model RoleCategoryAccess {
  id         String   @id @default(uuid()) @db.Uuid
  role       UserRole
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([role, categoryId])
  @@index([role])
  @@map("role_category_access")
}

model UserCategoryAccess {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, categoryId])
  @@index([userId])
  @@map("user_category_access")
}

model User {
  id               String                @id @default(uuid()) @db.Uuid
  name             String
  email            String                @unique
  password         String
  role             UserRole
  categoryAccess   UserCategoryAccess[]  
  createdAt        DateTime              @default(now()) @map("created_at")
  documentVersions DocumentVersion[]

  @@map("users")
}

model ArchiveYear {
  id        String     @id @default(uuid()) @db.Uuid
  year      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  documents Document[]
  @@map("archive_years")
}

model Document {
  id                   String               @id @default(uuid()) @db.Uuid
  title                String
  documentNumber       String?              @map("document_number")
  categoryId           String               @map("category_id") @db.Uuid
  category             Category             @relation(fields: [categoryId], references: [id])

  schoolYearId         String?               @map("school_year_id") @db.Uuid
  schoolYear           ArchiveYear?          @relation(fields: [schoolYearId], references: [id])

  description          String?
  tags                 String[]             @default([])
  confidentialityLevel ConfidentialityLevel @default(INTERNAL) @map("confidentiality_level")

  currentVersionId     String?              @unique @map("current_version_id") @db.Uuid
  currentVersion       DocumentVersion?     @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  versions             DocumentVersion[]    @relation("DocumentVersions")

  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([schoolYearId])
  @@map("documents")
}

model DocumentVersion {
  id                 String    @id @default(uuid()) @db.Uuid
  documentId         String    @map("document_id") @db.Uuid
  document           Document  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber      String    @map("version_number")
  filePath           String    @map("file_path")
  isColdStorage      Boolean   @default(false) @map("is_cold_storage")
  uploadedById       String    @map("uploaded_by_id") @db.Uuid
  uploadedBy         User      @relation(fields: [uploadedById], references: [id])
  createdAt          DateTime  @default(now()) @map("created_at")
  currentForDocument Document? @relation("CurrentVersion")

  @@index([documentId])
  @@map("document_versions")
}